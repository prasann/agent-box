# Ollama Configuration (shared)
AB_OLLAMA_MODEL=llama3.2:3b
AB_OLLAMA_URL=http://localhost:11434

# Azure OpenAI (text agent). Auth via `az login` (Entra ID), no key needed.
AB_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AB_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Logging
AB_LOG_LEVEL=INFO
AB_LOG_FILE=data/logs/ab.log

# Gmail Agent (future)
# AB_GMAIL_LABEL_NAME=NeedsReview/Spam
# AB_GMAIL_MAX_EMAILS_PER_RUN=1000
# AB_GMAIL_MARK_AS_READ=false

# Text Agent
AB_TEXT_SHOW_PREVIEW=true

# Reads: local storage and bounded optional cloud assessment.
AB_READS_DB=~/.agb/reads/reads.db
AB_READS_MAX_CALLS=12
AB_READS_TIMEOUT_SECONDS=120

# Decision configuration is disabled until the deployment's inference schema is verified.
# Endpoint is the complete HTTPS inference URL, including any API-version query.
# AB_READS_DECISION_ENDPOINT=
# AB_READS_DECISION_DEPLOYMENT=Microsoft-Decision-1
# AB_READS_DECISION_API_KEY=
# No key: use Entra ID via DefaultAzureCredential instead.
# JSON request template: exact-value placeholders $context, $question, $options,
# and optionally $deployment. Use the deployment's real schema, not OpenAI's.
# AB_READS_DECISION_REQUEST_TEMPLATE=
# Dot-separated path to the {option: probability} object in the native response.
# AB_READS_DECISION_RESPONSE_PATH=
