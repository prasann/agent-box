{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "python ~/.agent-box-toolkit/hooks/scripts/safety_check.py",
        "osx": "python ~/.agent-box-toolkit/hooks/scripts/safety_check.py",
        "events": ["run_in_terminal"],
        "cwd": "."
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ~/.agent-box-toolkit/hooks/scripts/notify.sh",
        "osx": "bash ~/.agent-box-toolkit/hooks/scripts/notify.sh",
        "timeout": 5
      }
    ]
  }
}
